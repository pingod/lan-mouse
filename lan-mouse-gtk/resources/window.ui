<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <menu id="main-menu">
    <item>
      <attribute name="label" translatable="yes">_Close window</attribute>
      <attribute name="action">window.close</attribute>
    </item>
  </menu>
  <template class="LanMouseWindow" parent="AdwApplicationWindow">
    <property name="default-width">760</property>
    <property name="default-height">660</property>
    <property name="width-request">520</property>
    <property name="height-request">520</property>
    <property name="title" translatable="yes">Lan Mouse</property>
    <property name="show-menubar">True</property>
    <property name="content">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwViewSwitcher" id="view_switcher">
                <property name="stack">main_stack</property>
                <property name="policy">wide</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="menu-model">main-menu</property>
              </object>
            </child>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="AdwViewStack" id="main_stack">
                <!-- ─────────────── Status ─────────────── -->
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">status</property>
                    <property name="title" translatable="yes">Status</property>
                    <property name="icon-name">utilities-system-monitor-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">Status</property>
                        <property name="icon-name">utilities-system-monitor-symbolic</property>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Service</property>
                            <property name="description" translatable="yes">Control the running daemon without leaving this window.</property>
                            <child>
                              <object class="AdwActionRow" id="pause_row">
                                <property name="title" translatable="yes">Pause</property>
                                <property name="subtitle" translatable="yes">release the pointer and stop capturing/emulating; the service keeps running</property>
                                <property name="icon-name">media-playback-pause-symbolic</property>
                                <child>
                                  <object class="GtkSwitch" id="pause_switch">
                                    <property name="valign">center</property>
                                    <signal name="notify::active" handler="handle_pause_toggled" swapped="true"/>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="force_release_row">
                                <property name="title" translatable="yes">Release input</property>
                                <property name="subtitle" translatable="yes">hand the pointer back to this machine immediately</property>
                                <property name="icon-name">input-mouse-symbolic</property>
                                <child>
                                  <object class="GtkButton" id="force_release_button">
                                    <property name="valign">center</property>
                                    <property name="label" translatable="yes">Release</property>
                                    <signal name="clicked" handler="handle_force_release_pressed" swapped="true"/>
                                    <style><class name="pill"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="active_device_row">
                                <property name="title" translatable="yes">Controlling</property>
                                <property name="subtitle" translatable="yes">this machine</property>
                                <property name="icon-name">input-keyboard-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="switch_device_row">
                                <property name="title" translatable="yes">Switch device</property>
                                <property name="subtitle" translatable="yes">take control back from the peer that currently holds it</property>
                                <property name="icon-name">object-flip-horizontal-symbolic</property>
                                <child>
                                  <object class="GtkButton" id="switch_device_button">
                                    <property name="valign">center</property>
                                    <property name="label" translatable="yes">Switch</property>
                                    <signal name="clicked" handler="handle_switch_device_pressed" swapped="true"/>
                                    <style><class name="pill"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Activity</property>
                            <property name="description" translatable="yes">Live counters for the running service.</property>
                            <child>
                              <object class="AdwActionRow" id="peers_row">
                                <property name="title" translatable="yes">Peers</property>
                                <property name="subtitle">-</property>
                                <property name="icon-name">network-transmit-receive-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="traffic_row">
                                <property name="title" translatable="yes">Forwarded</property>
                                <property name="subtitle">-</property>
                                <property name="icon-name">go-next-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="latency_row">
                                <property name="title" translatable="yes">Latency</property>
                                <property name="subtitle">-</property>
                                <property name="icon-name">alarm-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="uptime_row">
                                <property name="title" translatable="yes">Uptime</property>
                                <property name="subtitle">-</property>
                                <property name="icon-name">preferences-system-time-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="port_row">
                                <property name="title" translatable="yes">Listen port</property>
                                <property name="subtitle">-</property>
                                <property name="icon-name">network-server-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup" id="capture_emulation_group">
                            <property name="title" translatable="yes">Backends</property>
                            <property name="description" translatable="yes">Which backend each side is using, and whether it is running.</property>
                            <child>
                              <object class="AdwActionRow" id="capture_status_row">
                                <property name="title">input capture</property>
                                <property name="subtitle">-</property>
                                <property name="icon-name">object-select-symbolic</property>
                                <child>
                                  <object class="GtkButton" id="input_capture_button">
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">object-rotate-right-symbolic</property>
                                        <property name="label" translatable="yes">Reenable</property>
                                      </object>
                                    </property>
                                    <signal name="clicked" handler="handle_capture" swapped="true"/>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="pill"/>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="emulation_status_row">
                                <property name="title">input emulation</property>
                                <property name="subtitle">-</property>
                                <property name="icon-name">object-select-symbolic</property>
                                <child>
                                  <object class="GtkButton" id="input_emulation_button">
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">object-rotate-right-symbolic</property>
                                        <property name="label" translatable="yes">Reenable</property>
                                      </object>
                                    </property>
                                    <property name="valign">center</property>
                                    <signal name="clicked" handler="handle_emulation" swapped="true"/>
                                    <style>
                                      <class name="pill"/>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- ─────────────── Devices ─────────────── -->
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">devices</property>
                    <property name="title" translatable="yes">Devices</property>
                    <property name="icon-name">computer-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">Devices</property>
                        <property name="icon-name">computer-symbolic</property>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Outgoing connections</property>
                            <property name="description" translatable="yes">Machines this one can drive. Expand a row for connection details.</property>
                            <property name="header-suffix">
                              <object class="GtkButton">
                                <signal name="clicked" handler="handle_add_client_pressed" swapped="true"/>
                                <property name="child">
                                  <object class="AdwButtonContent">
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="label" translatable="yes">Add</property>
                                  </object>
                                </property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </property>
                            <child>
                              <object class="GtkListBox" id="client_list">
                                <property name="selection-mode">none</property>
                                <child type="placeholder">
                                  <object class="AdwActionRow" id="client_placeholder">
                                    <property name="title">No connections</property>
                                    <property name="subtitle">add a client with the + button</property>
                                  </object>
                                </child>
                                <style>
                                  <class name="boxed-list" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Inbound</property>
                            <property name="description" translatable="yes">Devices currently driving this machine.</property>
                            <property name="header-suffix">
                              <object class="GtkButton" id="refresh_peers_button">
                                <signal name="clicked" handler="handle_refresh_peers_pressed" swapped="true"/>
                                <property name="child">
                                  <object class="AdwButtonContent">
                                    <property name="icon-name">view-refresh-symbolic</property>
                                    <property name="label" translatable="yes">Refresh</property>
                                  </object>
                                </property>
                                <style><class name="flat"/></style>
                              </object>
                            </property>
                            <child>
                              <object class="GtkListBox" id="incoming_list">
                                <property name="selection-mode">none</property>
                                <child type="placeholder">
                                  <object class="AdwActionRow" id="incoming_placeholder">
                                    <property name="title">No inbound connections</property>
                                    <property name="subtitle">this machine is not being driven right now</property>
                                  </object>
                                </child>
                                <style>
                                  <class name="boxed-list"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Incoming connections</property>
                            <property name="description" translatable="yes">Devices allowed to drive this machine.</property>
                            <property name="header-suffix">
                              <object class="GtkButton">
                                <signal name="clicked" handler="handle_add_cert_fingerprint" swapped="true"/>
                                <property name="child">
                                  <object class="AdwButtonContent">
                                    <property name="icon-name">auth-fingerprint-symbolic</property>
                                    <property name="label" translatable="yes">Authorize</property>
                                  </object>
                                </property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </property>
                            <child>
                              <object class="GtkListBox" id="authorized_list">
                                <property name="selection-mode">none</property>
                                <child type="placeholder">
                                  <object class="AdwActionRow" id="authorized_placeholder">
                                    <property name="title">No devices authorized</property>
                                    <property name="subtitle">use the Authorize button to trust a device</property>
                                  </object>
                                </child>
                                <style>
                                  <class name="boxed-list" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- ─────────────── Settings ─────────────── -->
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">settings</property>
                    <property name="title" translatable="yes">Settings</property>
                    <property name="icon-name">emblem-system-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">Settings</property>
                        <property name="icon-name">emblem-system-symbolic</property>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">This machine</property>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">hostname and port</property>
                                <child>
                                  <object class="GtkLabel" id="hostname_label">
                                    <property name="valign">center</property>
                                    <property name="selectable">true</property>
                                    <property name="label">hostname</property>
                                    <style><class name="dim-label"/></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="copy_hostname_button">
                                    <property name="valign">center</property>
                                    <signal name="clicked" handler="handle_copy_hostname" swapped="true"/>
                                    <style><class name="flat"/></style>
                                    <property name="child">
                                      <object class="GtkImage" id="hostname_copy_icon">
                                        <property name="icon-name">edit-copy-symbolic</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkEntry" id="port_entry">
                                    <property name="max-width-chars">5</property>
                                    <property name="input_purpose">GTK_INPUT_PURPOSE_NUMBER</property>
                                    <property name="xalign">0.5</property>
                                    <property name="valign">center</property>
                                    <property name="placeholder-text">4242</property>
                                    <property name="width-chars">5</property>
                                    <signal name="changed" handler="handle_port_changed" swapped="true"/>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="port_edit_apply">
                                    <property name="valign">center</property>
                                    <property name="visible">false</property>
                                    <signal name="clicked" handler="handle_port_edit_apply" swapped="true"/>
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">object-select-symbolic</property>
                                      </object>
                                    </property>
                                    <style><class name="flat"/><class name="success"/></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="port_edit_cancel">
                                    <property name="valign">center</property>
                                    <property name="visible">false</property>
                                    <signal name="clicked" handler="handle_port_edit_cancel" swapped="true"/>
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">window-close-symbolic</property>
                                      </object>
                                    </property>
                                    <style><class name="flat"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="fingerprint_row">
                                <property name="title" translatable="yes">Certificate fingerprint</property>
                                <property name="subtitle">-</property>
                                <child>
                                  <object class="GtkButton" id="copy-fingerprint-button">
                                    <property name="icon-name">edit-copy-symbolic</property>
                                    <property name="valign">center</property>
                                    <signal name="clicked" handler="handle_copy_fingerprint" swapped="true"/>
                                    <style><class name="flat"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Startup and maintenance</property>
                            <child>
                              <object class="AdwActionRow" id="autostart_row">
                                <property name="title" translatable="yes">Start with session</property>
                                <property name="subtitle" translatable="yes">launch lan-mouse automatically at login</property>
                                <property name="icon-name">system-run-symbolic</property>
                                <child>
                                  <object class="GtkSwitch" id="autostart_switch">
                                    <property name="valign">center</property>
                                    <signal name="notify::active" handler="handle_autostart_toggled" swapped="true"/>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="restart_interval_row">
                                <property name="title" translatable="yes">Scheduled restart</property>
                                <property name="subtitle" translatable="yes">restart every N seconds; empty disables it</property>
                                <property name="icon-name">alarm-symbolic</property>
                                <child>
                                  <object class="GtkEntry" id="restart_interval_entry">
                                    <property name="valign">center</property>
                                    <property name="input_purpose">GTK_INPUT_PURPOSE_NUMBER</property>
                                    <property name="width-chars">8</property>
                                    <property name="placeholder-text" translatable="yes">seconds</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="restart_interval_apply">
                                    <property name="valign">center</property>
                                    <property name="label" translatable="yes">Apply</property>
                                    <signal name="clicked" handler="handle_restart_interval_apply" swapped="true"/>
                                    <style><class name="pill"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="restart_row">
                                <property name="title" translatable="yes">Restart service</property>
                                <property name="subtitle" translatable="yes">exit so the service manager starts a fresh process</property>
                                <property name="icon-name">view-refresh-symbolic</property>
                                <child>
                                  <object class="GtkButton" id="restart_button">
                                    <property name="valign">center</property>
                                    <property name="label" translatable="yes">Restart</property>
                                    <signal name="clicked" handler="handle_restart_pressed" swapped="true"/>
                                    <style><class name="pill"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="release_bind_row">
                                <property name="title" translatable="yes">Release shortcut</property>
                                <property name="subtitle" translatable="yes">pulls the pointer back while it is on another machine, e.g. Ctrl+Shift+Alt+P</property>
                                <property name="icon-name">input-keyboard-symbolic</property>
                                <child>
                                  <object class="GtkEntry" id="release_bind_entry">
                                    <property name="valign">center</property>
                                    <property name="width-chars">20</property>
                                    <signal name="activate" handler="handle_release_bind_activate" swapped="true"/>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="release_bind_apply">
                                    <property name="valign">center</property>
                                    <property name="label" translatable="yes">Apply</property>
                                    <signal name="clicked" handler="handle_release_bind_apply" swapped="true"/>
                                    <style><class name="pill"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="reload_row">
                                <property name="title" translatable="yes">Reload configuration</property>
                                <property name="subtitle" translatable="yes">re-read config.toml now; file changes reload automatically</property>
                                <property name="icon-name">document-revert-symbolic</property>
                                <child>
                                  <object class="GtkButton" id="reload_button">
                                    <property name="valign">center</property>
                                    <property name="label" translatable="yes">Reload</property>
                                    <signal name="clicked" handler="handle_reload_pressed" swapped="true"/>
                                    <style><class name="pill"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Hotkeys</property>
                            <property name="description" translatable="yes">Fire a key on another machine, or switch devices, while you keep typing here. The local keystroke is not intercepted.</property>
                            <property name="header-suffix">
                              <object class="GtkButton" id="add_hotkey_button">
                                <signal name="clicked" handler="handle_add_hotkey_pressed" swapped="true"/>
                                <property name="child">
                                  <object class="AdwButtonContent">
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="label" translatable="yes">Add</property>
                                  </object>
                                </property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </property>
                            <child>
                              <object class="GtkListBox" id="hotkey_list">
                                <property name="selection-mode">none</property>
                                <property name="show-separators">true</property>
                                <style>
                                  <class name="boxed-list"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="hotkey_placeholder_row">
                                <property name="title" translatable="yes">No hotkeys</property>
                                <property name="subtitle" translatable="yes">add a rule with the + button</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">About</property>
                            <child>
                              <object class="AdwActionRow" id="version_row">
                                <property name="title" translatable="yes">Version</property>
                                <property name="subtitle">-</property>
                                <property name="icon-name">help-about-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- ─────────────── Logs ─────────────── -->
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">logs</property>
                    <property name="title" translatable="yes">Logs</property>
                    <property name="icon-name">utilities-terminal-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">Logs</property>
                        <property name="icon-name">utilities-terminal-symbolic</property>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Live output</property>
                            <property name="description" translatable="yes">Records stream in as the service writes them. Raise the level to debug when something misbehaves.</property>
                            <property name="header-suffix">
                              <object class="GtkBox">
                                <property name="spacing">6</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkButton" id="log_clear_button">
                                    <signal name="clicked" handler="handle_log_clear_pressed" swapped="true"/>
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">edit-clear-symbolic</property>
                                        <property name="label" translatable="yes">Clear</property>
                                      </object>
                                    </property>
                                    <style><class name="flat"/></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="log_refresh_button">
                                    <signal name="clicked" handler="handle_log_refresh_pressed" swapped="true"/>
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">view-refresh-symbolic</property>
                                        <property name="label" translatable="yes">Refresh</property>
                                      </object>
                                    </property>
                                    <style><class name="flat"/></style>
                                  </object>
                                </child>
                              </object>
                            </property>
                            <child>
                              <object class="AdwComboRow" id="log_level_combo">
                                <property name="title" translatable="yes">Level</property>
                                <property name="subtitle">-</property>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item>off</item>
                                      <item>error</item>
                                      <item>warn</item>
                                      <item>info</item>
                                      <item>debug</item>
                                      <item>trace</item>
                                    </items>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="log_level_row">
                                <property name="title" translatable="yes">Active level</property>
                                <child>
                                  <object class="GtkLabel" id="log_level_label">
                                    <property name="label">-</property>
                                    <property name="valign">center</property>
                                    <style><class name="dim-label"/></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="min-content-height">320</property>
                                <property name="has-frame">true</property>
                                <property name="child">
                                  <object class="GtkTextView" id="log_view">
                                    <property name="editable">false</property>
                                    <property name="monospace">true</property>
                                    <property name="wrap-mode">GTK_WRAP_WORD_CHAR</property>
                                    <property name="top-margin">6</property>
                                    <property name="bottom-margin">6</property>
                                    <property name="left-margin">6</property>
                                    <property name="right-margin">6</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
